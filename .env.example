# Токен Telegram-бота (получите у @BotFather)
BOT_TOKEN=1

# URL, по которому размещён ваш index.html
# Для Telegram Mini App требуется HTTPS
WEBAPP_URL=https://your-domain.com/tksu_schedule/

# Токены API APEKS для автозагрузки расписания на сервере
TOKEN_STUDENTS=
TOKEN_TEACHERS=

# Telegram ID администратора бота (для команды /update_data и системных уведомлений)
ADMIN_ID=

# Автозагрузка расписания
AUTO_FETCH_ENABLED=true
AUTO_FETCH_TIME=04:00
# Скрипт загрузки (по умолчанию scripts/script.py)
FETCH_SCRIPT=scripts/script.py
